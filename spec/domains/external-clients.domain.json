{
  "name": "external-clients",
  "description": "外部サービスへの最小クライアント。AWS (SigV4 / S3 / 認証情報)、Redis (RESP)、MQTT (C++ 版の購読用)、AI / Notion API、共通の JSON fetch。",
  "presetRules": [],
  "templateRules": [],
  "membership": [
    {
      "pathPattern": "(^|/)src/aws/(?:.*/)?[^/]+$"
    },
    {
      "pathPattern": "(^|/)src/redis/(?:.*/)?[^/]+$"
    },
    {
      "pathPattern": "(^|/)src/ai/(?:.*/)?[^/]+$"
    },
    {
      "pathPattern": "(^|/)src/net/(?:.*/)?[^/]+$"
    },
    {
      "pathPattern": "(^|/)cpp/src/mqtt/(?:.*/)?[^/]+$"
    },
    {
      "pathPattern": "(^|/)cpp/include/portus/redis\\.hpp$"
    },
    {
      "pathPattern": "(^|/)cpp/include/portus/net\\.hpp$"
    },
    {
      "pathPattern": "(^|/)cpp/include/portus/aws\\.hpp$"
    },
    {
      "pathPattern": "(^|/)cpp/include/portus/ai\\.hpp$"
    },
    {
      "pathPattern": "(^|/)cpp/include/portus/mqtt\\.hpp$"
    },
    {
      "pathPattern": "(^|/)cpp/tests/redis_test\\.cpp$"
    },
    {
      "pathPattern": "(^|/)cpp/tests/net_test\\.cpp$"
    },
    {
      "pathPattern": "(^|/)cpp/tests/aws_test\\.cpp$"
    },
    {
      "pathPattern": "(^|/)cpp/tests/mqtt_test\\.cpp$"
    }
  ]
}
