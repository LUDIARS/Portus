{
  "name": "external-clients",
  "description": "外部サービスへの最小クライアント。AWS (SigV4 / S3 / 認証情報)、Redis (RESP)、AI / Notion API、外部への HTTP/1.1 要求 (自前実装) と JSON 要求・SSE。",
  "presetRules": [],
  "templateRules": [],
  "membership": [
    {
      "pathPattern": "(^|/)src/aws/(?:.*/)?[^/]+$"
    },
    {
      "pathPattern": "(^|/)src/redis/(?:.*/)?[^/]+$"
    },
    {
      "pathPattern": "(^|/)src/ai/(?:.*/)?[^/]+$"
    },
    {
      "pathPattern": "(^|/)src/net/(?:.*/)?[^/]+$"
    },
    {
      "pathPattern": "(^|/)test/net-[^/]+\\.test\\.ts$"
    }
  ]
}
