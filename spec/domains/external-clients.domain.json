    {
      "pathPattern": "(^|/)src/redis/(?:.*/)?[^/]+$"
    },
    {
      "pathPattern": "(^|/)src/ai/(?:.*/)?[^/]+$"
    },
    {
      "pathPattern": "(^|/)src/net/(?:.*/)?[^/]+$"
    }
  ]
}
